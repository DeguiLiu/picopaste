// @file picopaste.rc.in
// @brief picopaste.exe resources; configured into picopaste.rc at build time.
//
// Configured rather than shipped as a plain .rc so the version has one source of
// truth: every @...@ below comes from the project() version in the root
// CMakeLists, and a hand-written second copy is exactly the "reports something
// other than the truth" failure this project exists to avoid. It is compiled
// only on Windows, where the root CMakeLists calls enable_language(RC).
//
// The three state icons the tray cycles through. The ids live in tray_icons.h so
// the .rc and tray.cpp cannot disagree. Order matters only in that the lowest id
// is the icon the shell shows for the .exe itself.
#include "tray_icons.h"

PICOPASTE_ICON_OK ICON "resources/picopaste-ok.ico"
PICOPASTE_ICON_WARN ICON "resources/picopaste-warn.ico"
PICOPASTE_ICON_ERR ICON "resources/picopaste-err.ico"

// What the shell reads in the file Properties dialog. FILEVERSION is the fixed
// 4-part numeric form, the strings are what a user actually sees, and both come
// from the same @PROJECT_VERSION@. Without this block the executable carries no
// version at all and the dialog shows a blank.
VS_VERSION_INFO VERSIONINFO
  FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
  FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
  FILEFLAGS 0x0L
  FILEOS VOS_NT_WINDOWS32
  FILETYPE VFT_APP
  FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "Uploads the clipboard image to a remote host and pastes its path"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "picopaste"
      VALUE "LegalCopyright", "MIT License, Copyright (c) 2026 liudegui"
      VALUE "OriginalFilename", "picopaste.exe"
      VALUE "ProductName", "picopaste"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
